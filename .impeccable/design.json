      "html": "<a class=\"ds-primary\" href=\"#proyectos\">Ver proyectos</a>",
      "css": ".ds-primary{font-family:Satoshi,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:14px 22px;font-size:14px;font-weight:700;text-decoration:none;border-radius:8px;white-space:nowrap;background:var(--solid,#3f60cc);color:var(--on-solid,#f6f8ff);transition:transform 120ms var(--ease,cubic-bezier(.23,1,.32,1)),background-color 180ms ease,color 180ms ease;}.ds-primary:focus-visible{outline:3px solid var(--accent,#9cb6ff);outline-offset:6px}.ds-primary:active{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-primary:hover{background:#3152bd;color:var(--on-solid,#f6f8ff)}}@media(max-width:600px){.ds-primary{font-size:13px;padding:14px 20px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important;animation:none!important}}"
    },
